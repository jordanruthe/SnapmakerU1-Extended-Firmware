# Runs before S50nginx, S50mosquitto, S50dropbear, S61moonraker and S80dnsmasq
# so the generated tweaks and runtime config are in place when they start.

case "$1" in
    start|restart|reload)
        /usr/local/sbin/security-setup apply
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
        ;;
esac

exit $?
