     def get_status(self, eventtime=None):
         return {}
 
+    def _library_entries(self):
+        # Re-read on change, so saving from the Filament Manager applies to the
+        # next load/unload without restarting Klipper.
+        try:
+            mtime = os.stat(self._library_path).st_mtime
+        except OSError:
+            mtime = None
+        if mtime == self._library_mtime:
+            return self._library
+        self._library_mtime = mtime
+        self._library = []
+        if mtime is None:
+            return self._library
+        try:
+            with open(self._library_path, 'r') as f:
+                filaments = json.load(f).get('filaments', [])
+            for item in filaments:
+                if not isinstance(item, dict) or not str(item.get('type') or '').strip():
+                    continue
+                entry = {
+                    'name': str(item.get('name') or ''),
+                    'vendor': str(item.get('vendor') or ''),
+                    'type': str(item['type']).strip(),
+                    'sub_type': str(item.get('sub_type') or ''),
+                    'base_type': str(item.get('base_type') or '').strip(),
+                }
+                try:
+                    for key in FILAMENT_LIBRARY_TEMP_KEYS:
+                        if item.get(key) not in (None, ''):
+                            entry[key] = int(item[key])
+                except (TypeError, ValueError):
+                    # Skip just this entry; the rest of the library still applies
+                    logging.error("[filament_parameters] ignoring library entry %r: invalid temperature", entry['name'] or entry['type'])
+                    continue
+                if item.get('is_soft') is not None:
+                    entry['is_soft'] = bool(item['is_soft'])
+                self._library.append(entry)
+            logging.info("[filament_parameters] loaded %d filament library entries", len(self._library))
+        except Exception as e:
+            logging.error("[filament_parameters] failed to load %s: %s", self._library_path, str(e))
+            self._library = []
+        return self._library
+
+    def _library_lookup(self, filament_vendor, filament_main_type, filament_sub_type):
+        norm = lambda value: str(value or '').strip().lower()
+        vendor, main_type, sub_type = norm(filament_vendor), norm(filament_main_type), norm(filament_sub_type)
+        entries = [e for e in self._library_entries() if norm(e['type']) == main_type]
+        if not entries:
+            return None
+        # Same precedence as the stock tables: exact, any subtype, generic
+        # vendor, generic vendor with any subtype. A blank vendor or subtype
+        # matches like `generic`.
+        wildcard = ('', 'generic')
+        for want_vendor, want_sub in ((vendor, sub_type), (vendor, None), (None, sub_type), (None, None)):
+            for e in entries:
+                ev, es = norm(e['vendor']), norm(e['sub_type'])
+                if (ev in wildcard if want_vendor is None else ev == want_vendor) and \
+                        (es in wildcard if want_sub is None else es == want_sub):
+                    return e
+        return None
+
     def _search_filament_param_value(self, dict_obj, filament_vendor, filament_main_type, filament_sub_type, key_name):
+        entry = self._library_lookup(filament_vendor, filament_main_type, filament_sub_type)
+        if entry is None:
+            return self._search_stock_param_value(dict_obj, filament_vendor, filament_main_type, filament_sub_type, key_name)
+        if entry.get(key_name) is not None:
+            return entry[key_name]
+        value = self._search_stock_param_value(dict_obj, filament_vendor, filament_main_type, filament_sub_type, key_name)
+        # A type the stock tables do not know (e.g. `PLA+`) has no `vol_speed`,
+        # which would discard every parameter; borrow its base type's instead.
+        if value is None and entry['base_type']:
+            value = self._search_stock_param_value(dict_obj, filament_vendor, entry['base_type'], filament_sub_type, key_name)
+        return value
+
+    def _search_stock_param_value(self, dict_obj, filament_vendor, filament_main_type, filament_sub_type, key_name):
         key = f'{filament_vendor}_{filament_main_type}_{filament_sub_type}_{key_name}'
         default_fill = 'generic'
 
